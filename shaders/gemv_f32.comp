#version 450
// One workgroup = one output row. Offline SPIR-V for --device vulkan.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform P { int m; int n; } p;

shared float buf[256];

void main() {
    const int row = int(gl_WorkGroupID.x);
    if (row >= p.m) return;
    const uint tid = gl_LocalInvocationID.x;
    float acc = 0.0;
    for (uint j = tid; j < uint(p.n); j += 256u) acc += w[uint(row) * uint(p.n) + j] * x[j];
    buf[tid] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) buf[tid] += buf[tid + s];
        barrier();
    }
    if (tid == 0u) y[row] = buf[0];
}
